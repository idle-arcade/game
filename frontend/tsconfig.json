{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // "node" is needed because the AppRouter type is checked through backend sources.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
