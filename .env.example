# Copy to .env (read by docker compose). Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=idle_arcade
MYSQL_USER=idle
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_PORT=8080
# Public frontend runtime settings. Enable only after access and 30-day retention
# are verified on the Rybbit instance. Recreate the frontend container after changes.
RYBBIT_ENABLED=false
RYBBIT_ENDPOINT=https://ry.idle-arcade.craftingservices.de/api
RYBBIT_SITE_ID=
