# Copy to .env (read by docker compose). Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=idle_arcade
MYSQL_USER=idle
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_PORT=8080
# Public frontend runtime settings. Enable only after access and 180-day retention
# are verified on the Rybbit instance. Recreate the frontend container after changes.
RYBBIT_ENABLED=false
RYBBIT_ENDPOINT=https://ry.idle-arcade.craftingservices.de/api
RYBBIT_SITE_ID=

# Optional server observability. Leave disabled until the private Collector is deployed.
# Use deploy/otel-collector.yml (or equivalent privacy filtering) before forwarding traces.
OTEL_ENABLED=false
OTEL_SDK_DISABLED=false
# Node: OTLP HTTP/protobuf base URL, e.g. http://collector:4318 (no /v1/traces).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# nginx: OTLP/gRPC endpoint, e.g. collector:4317 (no path).
NGINX_OTEL_EXPORTER_OTLP_ENDPOINT=
BACKEND_OTEL_SERVICE_NAME=idle-arcade-backend
FRONTEND_OTEL_SERVICE_NAME=idle-arcade-frontend
# Example: service.namespace=idle-arcade,deployment.environment.name=preview
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_TRACES_SAMPLER=parentbased_always_on
LOG_LEVEL=info
