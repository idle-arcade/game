// Tables required by Better Auth (core + username plugin).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String            @id
  name            String            @db.Text
  email           String            @unique
  emailVerified   Boolean           @default(false)
  image           String?           @db.Text
  username        String?           @unique
  displayUsername String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  accounts        Account[]
  balances        CurrencyBalance[]
  roomSyncs       RoomSync[]
  dartsRoom       DartsRoom?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Stable currency ids, one per room (Darts, Scratch Cards, Fishing, Gacha). Display names live in the frontend.
enum Currency {
  beers
  shamrocks
  fish
  coins
}

model CurrencyBalance {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency  Currency
  digits    BigInt   @db.UnsignedBigInt
  zeros     Int      @db.UnsignedInt

  /// Ranking key for highscores
  magnitude Int      @default(0) @db.UnsignedInt
  mantissa  BigInt   @default(0) @db.UnsignedBigInt

  @@id([userId, currency])
  @@index([currency, magnitude(sort: Desc), mantissa(sort: Desc), userId], map: "currency_balance_rank_idx")
  @@map("currency_balance")
}

/// Rooms with a synced simulation.
enum Room {
  darts
}

/// Sync session of one user in one room. Its row lock serializes all changes to that room's state.
model RoomSync {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  room    Room
  /// Game time (ms) of the last committed simulation step.
  t       BigInt @db.UnsignedBigInt
  /// Renewed on each page load; batches from older sessions are rejected.
  epoch   String @db.VarChar(64)
  /// Last applied batch of this session.
  lastSeq Int    @db.UnsignedInt

  @@id([userId, room])
  @@map("room_sync")
}

model DartsRoom {
  userId           String @id
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  betterDarts      Int    @default(0) @db.UnsignedInt
  moreDarts        Int    @default(0) @db.UnsignedInt
  lessCooldown     Int    @default(0) @db.UnsignedInt
  biggerTargets    Int    @default(0) @db.UnsignedInt
  pubPlayer        Int    @default(0) @db.UnsignedInt
  clubPlayer       Int    @default(0) @db.UnsignedInt
  leaguePlayer     Int    @default(0) @db.UnsignedInt
  tournamentPlayer Int    @default(0) @db.UnsignedInt
  pro              Int    @default(0) @db.UnsignedInt
  worldChampion    Int    @default(0) @db.UnsignedInt

  @@map("darts_room")
}
