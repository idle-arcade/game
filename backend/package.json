{
  "name": "@idle-arcade/backend",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/trpc/router.ts"
    },
    "./schemas/auth": "./src/schemas/auth.ts"
  },
  "scripts": {
    "predev": "prisma migrate deploy",
    "dev": "node --watch-path=src --watch-preserve-output --import tsx --import ./src/instrumentation.ts src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && npm run docs:generate",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "docs:generate": "node --no-experimental-strip-types scripts/generate-openapi.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@prisma/adapter-mariadb": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "~1.7.10",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "prisma": "~7.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trpc/openapi": "11.19.0-alpha",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15"
  }
}
