NODE_ENV=development
PORT=3000
# Local dev connects as root so `prisma migrate dev` can create its shadow database.
DATABASE_URL=mysql://root:change-me-root@localhost:3306/idle_arcade
# At least 32 characters; can be the same value as in the root .env.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin the browser uses (the Vite dev server locally).
BETTER_AUTH_URL=http://localhost:5173
